      "focus_x": 0.46,
      "source_time": "01:20:33.43-01:20:39.11",
      "lines": ["如果当时知道会经历什么", "那些痛苦和煎熬", "那种脆弱无助的感觉", "还有必须承受的挑战"],
      "line_sources": [
        {"source_time": "01:20:33.43", "original_excerpt": "had we realized the pain and suffering"},
