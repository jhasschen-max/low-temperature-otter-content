      "focus_x": 0.50,
      "source_time": "00:03:45-00:06:15",
      "lines": ["二十一岁时，我夹在两种期待之间", "一边是我真正想要的人生", "一边是亲近的人期待的安稳", "那时我最害怕的", "不是贫穷，而是失败"],
      "line_sources": [
