      "frame_time": "00:07:38",
      "focus_x": 0.50,
      "source_time": "00:07:32-00:07:44",
      "lines": ["什么算失败，本应由你决定", "但只要你允许", "世界就会急着给你", "一整套现成的标准", "再替你宣判输赢"],
      "line_sources": [
